      "css": ".ds-btn-set{display:flex;width:100%;align-items:center;justify-content:center;gap:8px;height:64px;border:0;border-radius:18px;background:var(--primary);color:var(--primary-foreground);font:900 18px/1 var(--font-sans);box-shadow:0 20px 25px -5px color-mix(in srgb,var(--primary) 30%,transparent),0 8px 10px -6px color-mix(in srgb,var(--primary) 30%,transparent);cursor:pointer;transition:transform .1s,background-color .15s}.ds-btn-set:hover{background:color-mix(in srgb,var(--primary) 90%,transparent)}.ds-btn-set:active{transform:scale(.98)}.ds-btn-set:focus-visible{outline:none;box-shadow:0 0 0 2px var(--background),0 0 0 4px var(--ring)}"
