      "html": "<button class=\"ds-btn\">התחילו</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 16px;border:0;border-radius:8px;background:var(--primary);color:var(--primary-foreground);font:500 14px/1 var(--font-sans);box-shadow:var(--shadow);cursor:pointer;transition:background-color .15s}.ds-btn:hover{background:color-mix(in srgb,var(--primary) 90%,transparent)}.ds-btn:focus-visible{outline:none;box-shadow:0 0 0 2px var(--background),0 0 0 4px var(--ring)}"
